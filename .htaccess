Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # The logo is a public site asset; keep other working files private.
  RewriteRule ^images/logo-white\.PNG$ - [L]
  RewriteRule ^(app|pages|tools|originals|images)(/|$) - [F,L]
  RewriteRule ^(router\.php|README\.md|PRODUCT\.md|DESIGN\.md)$ - [F,L]

  # Send every page address through index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(webp|woff2|svg|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
